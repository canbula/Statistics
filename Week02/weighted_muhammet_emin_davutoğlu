import random

def weighted_srs(data, n, weights, with_replacement):
    if with_replacement:
        return random.choices(data, weights=weights, k=n)
    sample, d, w = [], list(data), list(weights)
    while len(sample) < n:
        pick = random.choices(range(len(d)), weights=w, k=1)[0]
        sample.append(d.pop(pick))
        w.pop(pick)
    return sample
